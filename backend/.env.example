# 复制为 .env 后按需修改
DATABASE_URL=postgres://smartdoor:smartdoor@localhost:5432/smartdoor
PORT=3000
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost
RUST_LOG=smartdoor_backend=debug,tower_http=debug,info

# 首次启动播种的默认管理员（仅在 users 表为空时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_TENANT_NAME=默认门窗厂

# 电子回执单分享链接的签名密钥（HMAC-SHA256）。
# ⚠️ 生产**必须**显式设置（缺省值是写死的开发值，泄漏后任何人都能伪造任意租户的分享链接）。
# 生成：openssl rand -hex 32
RECEIPT_SECRET=change-me-to-a-random-64-hex-string

# 数据库连接的**会话时区**（IANA 名）。默认 Asia/Shanghai。
# 全栈的时间基准是库的 CURRENT_DATE（下单日期默认值、财务「近 N 天」、扫码统计「当天/本周/本月」），
# 而 CURRENT_DATE 取的是会话时区 —— 库是 UTC 的话，北京 00:00–08:00 这 8 小时会差一天。
# 只作用于本进程连出去的连接，不改库本身。生产库时区若与开发不同，改这里。
DB_TIMEZONE=Asia/Shanghai
